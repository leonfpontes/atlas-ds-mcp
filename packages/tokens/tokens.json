{
  "$description": "Atlas design tokens (W3C DTCG). Light values in $value; dark values in $extensions[\"atlas.modes\"].dark (a token without one is the same in both themes). Source of the shadcn/ui theme: pnpm --filter @leonfpontes/atlas-tokens build writes dist/tokens.css and dist/theme.css.",
  "color": {
    "$type": "color",
    "background": {
      "$value": "#FFFFFF",
      "$description": "Page background.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#11151C"
        }
      }
    },
    "foreground": {
      "$value": "#161A22",
      "$description": "Body text on background. 17.4:1.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#E8EBF1"
        }
      }
    },
    "card": {
      "$value": "#FFFFFF",
      "$description": "Card surface.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#1A1F29"
        }
      }
    },
    "card-foreground": {
      "$value": "#161A22",
      "$description": "Text on card.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#E8EBF1"
        }
      }
    },
    "popover": {
      "$value": "#FFFFFF",
      "$description": "Popover, Select and Command surface.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#1A1F29"
        }
      }
    },
    "popover-foreground": {
      "$value": "#161A22",
      "$description": "Text on popover.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#E8EBF1"
        }
      }
    },
    "primary": {
      "$value": "#0B5CAD",
      "$description": "Main action, links and the selected state. The only accent color.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#6FA8F5"
        }
      }
    },
    "primary-foreground": {
      "$value": "#FFFFFF",
      "$description": "Text on primary.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#11151C"
        }
      }
    },
    "secondary": {
      "$value": "#EDEFF3",
      "$description": "Secondary button fill.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#232937"
        }
      }
    },
    "secondary-foreground": {
      "$value": "#161A22",
      "$description": "Text on secondary.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#E8EBF1"
        }
      }
    },
    "muted": {
      "$value": "#F6F7F9",
      "$description": "Quiet surface: table header, code tab, disabled field.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#1A1F29"
        }
      }
    },
    "muted-foreground": {
      "$value": "#4D5566",
      "$description": "Secondary text: descriptions, hints, meta lines. 7.5:1.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#9AA3B5"
        }
      }
    },
    "accent": {
      "$value": "#EDEFF3",
      "$description": "Hover fill for ghost and outline controls.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#232937"
        }
      }
    },
    "accent-foreground": {
      "$value": "#161A22",
      "$description": "Text on accent.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#E8EBF1"
        }
      }
    },
    "destructive": {
      "$value": "#B23A00",
      "$description": "Errors and destructive actions (vermilion). Also error text.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#FF8A5C"
        }
      }
    },
    "destructive-foreground": {
      "$value": "#FFFFFF",
      "$description": "Atlas extension: text on a destructive fill.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#11151C"
        }
      }
    },
    "destructive-subtle": {
      "$value": "#FDEBE3",
      "$description": "Atlas extension: error Alert and Badge background.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#3A1E14"
        }
      }
    },
    "border": {
      "$value": "#DCE0E7",
      "$description": "Dividers and surface borders (1 px).",
      "$extensions": {
        "atlas.modes": {
          "dark": "#2E3542"
        }
      }
    },
    "input": {
      "$value": "#8A93A6",
      "$description": "Form control border. Non-text, 3:1.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#6B7385"
        }
      }
    },
    "ring": {
      "$value": "#0B5CAD",
      "$description": "Focus ring (3 px at 50%) and focused border.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#6FA8F5"
        }
      }
    },
    "success": {
      "$value": "#00745A",
      "$description": "Atlas extension: success text, icon and fill (bluish green).",
      "$extensions": {
        "atlas.modes": {
          "dark": "#4CC9A0"
        }
      }
    },
    "success-foreground": {
      "$value": "#FFFFFF",
      "$description": "Atlas extension: text on a success fill.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#11151C"
        }
      }
    },
    "success-subtle": {
      "$value": "#E3F5EF",
      "$description": "Atlas extension: success Alert and Badge background.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#12302A"
        }
      }
    },
    "warning": {
      "$value": "#8C5A00",
      "$description": "Atlas extension: warning text and icon (amber). Amber means example or warning, nothing else.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#F5B642"
        }
      }
    },
    "warning-subtle": {
      "$value": "#FFF3D6",
      "$description": "Atlas extension: warning Alert and Badge background.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#33280F"
        }
      }
    },
    "warning-accent": {
      "$value": "#E69F00",
      "$description": "Atlas extension: amber marker for example data. Decorative only, never for text."
    },
    "info": {
      "$value": "{color.primary}",
      "$description": "Atlas extension: info text and icon. Same as primary."
    },
    "info-subtle": {
      "$value": "#E7F0FB",
      "$description": "Atlas extension: info Alert and Badge background.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#1B2A40"
        }
      }
    },
    "text-subtle": {
      "$value": "#636B7D",
      "$description": "Atlas extension: placeholders and the least important text.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#9AA3B5"
        }
      }
    },
    "sidebar": {
      "$value": "#F6F7F9",
      "$description": "Sidebar background.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#1A1F29"
        }
      }
    },
    "sidebar-foreground": {
      "$value": "#161A22",
      "$description": "Sidebar text.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#E8EBF1"
        }
      }
    },
    "sidebar-accent": {
      "$value": "#E7F0FB",
      "$description": "Selected sidebar item. Dark is lighter than the sidebar so the active item stands out.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#1F3A60"
        }
      }
    },
    "sidebar-accent-foreground": {
      "$value": "#0B5CAD",
      "$description": "Text of the selected sidebar item.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#E8EBF1"
        }
      }
    },
    "sidebar-border": {
      "$value": "#DCE0E7",
      "$description": "Sidebar border.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#2E3542"
        }
      }
    },
    "sidebar-primary": {
      "$value": "{color.primary}",
      "$description": "shadcn sidebar primary."
    },
    "sidebar-primary-foreground": {
      "$value": "{color.primary-foreground}",
      "$description": "Text on sidebar primary."
    },
    "sidebar-ring": {
      "$value": "{color.ring}",
      "$description": "Focus ring inside the sidebar."
    },
    "chart-1": {
      "$value": "{color.primary}",
      "$description": "Chart series 1: blue. Each series keeps its hue in both themes."
    },
    "chart-2": {
      "$value": "{color.success}",
      "$description": "Chart series 2: bluish green."
    },
    "chart-3": {
      "$value": "#E69F00",
      "$description": "Chart series 3: amber.",
      "$extensions": {
        "atlas.modes": {
          "dark": "#F5B642"
        }
      }
    },
    "chart-4": {
      "$value": "{color.destructive}",
      "$description": "Chart series 4: vermilion."
    },
    "chart-5": {
      "$value": "{color.text-subtle}",
      "$description": "Chart series 5: grey."
    },
    "code": {
      "bg": {
        "$value": "#161A22",
        "$description": "Code block background, the same in both themes."
      },
      "fg": {
        "$value": "#E8EBF1",
        "$description": "Code text."
      },
      "dim": {
        "$value": "#9AA3B5",
        "$description": "Comments and line numbers."
      },
      "add": {
        "$value": "#4CC9A0",
        "$description": "Added line in a diff."
      },
      "del": {
        "$value": "#FF8A5C",
        "$description": "Removed line in a diff."
      },
      "key": {
        "$value": "#6FA8F5",
        "$description": "Keywords and JSX tags."
      },
      "str": {
        "$value": "#F5B642",
        "$description": "Strings."
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["IBM Plex Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Interface and prose. SIL Open Font License."
      },
      "mono": {
        "$value": ["IBM Plex Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"],
        "$description": "Code, commands and token names only."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "Body text."
      },
      "medium": {
        "$value": 500,
        "$description": "Labels, buttons, section labels."
      },
      "semibold": {
        "$value": 600,
        "$description": "Headings."
      }
    },
    "size": {
      "$type": "dimension",
      "12": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Badges and captions."
      },
      "13": {
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$description": "Code blocks, section labels and meta lines."
      },
      "14": {
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "Body in dense UI: tables, forms, buttons."
      },
      "16": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Body on marketing pages; card titles."
      },
      "17": {
        "$value": {
          "value": 17,
          "unit": "px"
        },
        "$description": "Lead paragraph."
      },
      "20": {
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "Subsection titles."
      },
      "28": {
        "$value": {
          "value": 28,
          "unit": "px"
        },
        "$description": "Section titles (24 px on phones)."
      },
      "36": {
        "$value": {
          "value": 36,
          "unit": "px"
        },
        "$description": "Page titles."
      },
      "44": {
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Hero headline."
      }
    }
  },
  "space": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "Spacing unit. Every space is a multiple: p-2 = 8 px, gap-6 = 24 px."
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      },
      "$description": "--radius (6 px). The scale below derives from it."
    },
    "sm": {
      "$value": {
        "value": 0.225,
        "unit": "rem"
      },
      "$description": "0.6 × base (3.6 px)."
    },
    "md": {
      "$value": {
        "value": 0.3,
        "unit": "rem"
      },
      "$description": "0.8 × base (4.8 px): buttons, inputs, badges."
    },
    "lg": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      },
      "$description": "1 × base (6 px): alerts."
    },
    "xl": {
      "$value": {
        "value": 0.525,
        "unit": "rem"
      },
      "$description": "1.4 × base (8.4 px): cards. The largest radius; no pills."
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 40,
        "unit": "px"
      },
      "$description": "Height of buttons, inputs and selects with a mouse."
    },
    "control-touch": {
      "$value": {
        "value": 44,
        "unit": "px"
      },
      "$description": "Height of controls on touch screens (pointer: coarse)."
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      },
      "$description": "Hover, press, copy feedback."
    },
    "base": {
      "$value": {
        "value": 180,
        "unit": "ms"
      },
      "$description": "Tabs, dialog, sheet closing."
    },
    "slow": {
      "$value": {
        "value": 240,
        "unit": "ms"
      },
      "$description": "Sheet opening."
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": {
      "$value": [0.2, 0.8, 0.2, 1],
      "$description": "Things that enter or respond."
    },
    "in": {
      "$value": [0.4, 0, 1, 1],
      "$description": "Things that leave."
    }
  },
  "shadow": {
    "$type": "shadow",
    "overlay": {
      "$value": [
        {
          "color": "#161A2240",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 30,
            "unit": "px"
          },
          "spread": {
            "value": -10,
            "unit": "px"
          }
        },
        {
          "color": "#161A2214",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 6,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Only Dialog, Sheet, Popover and Toast. Surfaces use borders, not shadows."
    }
  }
}
