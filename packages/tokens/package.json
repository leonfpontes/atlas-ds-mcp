{
  "name": "@leonfpontes/atlas-tokens",
  "version": "0.3.0",
  "description": "Atlas design tokens in the W3C Design Tokens (DTCG) format, with light and dark themes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonfpontes/atlas-ds-mcp.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/leonfpontes/atlas-ds-mcp#readme",
  "bugs": {
    "url": "https://github.com/leonfpontes/atlas-ds-mcp/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "atlas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.json": "./tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node dist/build.js",
    "typecheck": "tsc --noEmit"
  }
}
