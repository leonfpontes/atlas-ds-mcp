{
  "name": "@leonfpontes/atlas-ui",
  "version": "0.2.0",
  "description": "Atlas React components: shadcn/ui themed with the Atlas tokens.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonfpontes/atlas-ds-mcp.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/leonfpontes/atlas-ds-mcp#readme",
  "bugs": {
    "url": "https://github.com/leonfpontes/atlas-ds-mcp/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "atlas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/ui/*": {
      "atlas-source": "./src/components/ui/*.tsx",
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    },
    "./styles.css": "./src/styles.css",
    "./manifest.json": "./atlas.manifest.json"
  },
  "files": [
    "dist",
    "src/styles.css",
    "atlas.manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && storybook build -o storybook-static --quiet",
    "typecheck": "tsc --noEmit",
    "storybook": "pnpm --filter @leonfpontes/atlas-tokens build && storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "build-storybook": "pnpm --filter @leonfpontes/atlas-tokens build && storybook build -o storybook-static --quiet"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@leonfpontes/atlas-tokens": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.80.0",
    "radix-ui": "1.8.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.9",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
