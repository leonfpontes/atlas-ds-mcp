# Copy to .env.local and fill in. Never commit real values.

# Only needed to run the evaluation (pnpm eval). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Public origin of the site, for the absolute og:image and og:url (e.g. https://atlas.example.dev).
# Set it in the deploy; local builds leave the tags relative.
SITE_URL=
