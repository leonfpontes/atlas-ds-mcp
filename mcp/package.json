{
  "name": "@leonfpontes/design-system-mcp",
  "version": "0.2.0",
  "description": "MCP server that gives coding agents the Atlas tokens, components and usage rules.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonfpontes/atlas-ds-mcp.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/leonfpontes/atlas-ds-mcp#readme",
  "bugs": {
    "url": "https://github.com/leonfpontes/atlas-ds-mcp/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "design-system-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "atlas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-data.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "smoke": "node scripts/smoke-stdio.mjs",
    "start:http": "node dist/cli.js --http"
  },
  "dependencies": {
    "@babel/parser": "8.1.3",
    "@leonfpontes/atlas-tokens": "workspace:*",
    "@tmcp/adapter-valibot": "0.1.7",
    "@tmcp/transport-http": "0.9.1",
    "@tmcp/transport-stdio": "0.5.2",
    "tmcp": "1.20.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@leonfpontes/atlas-ui": "workspace:*"
  }
}
